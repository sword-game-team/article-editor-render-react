{
  "name": "article-content-renderer-next",
  "version": "0.1.0",
  "description": "A safe React renderer for the Article Content Protocol ProseMirror JSON format.",
  "author": "NovaVoyager",
  "license": "MIT",
  "keywords": [
    "react",
    "editor",
    "tiptap",
    "article-editor",
    "prosemirror",
    "render"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sword-game-team/article-editor-render-react.git"
  },
  "homepage": "https://github.com/sword-game-team/article-editor-render-react#readme",
  "bugs": {
    "url": "https://github.com/sword-game-team/article-editor-render-react/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "protocol"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/article-content-renderer-react.css"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "demo:typecheck": "tsc -p demo/tsconfig.json --noEmit",
    "demo:build": "npm run demo:typecheck && vite build --config demo/vite.config.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run typecheck && npm run test:run && npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
